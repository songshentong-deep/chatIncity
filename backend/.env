# 服务器配置
SERVER_PORT=8001
GIN_MODE=debug

# PostgreSQL数据库配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=chat
POSTGRES_PASSWORD=password
POSTGRES_DB=social_app
POSTGRES_SSLMODE=disable

# MongoDB配置
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=social_app

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE_TIME=24

# 文件上传配置
UPLOAD_MAX_SIZE=10485760
UPLOAD_STORAGE_PATH=./uploads

# 人脸识别API配置
FACE_API_PROVIDER=baidu
FACE_API_KEY=your-face-api-key
FACE_API_SECRET=your-face-api-secret
FACE_API_ENDPOINT=https://aip.baidubce.com

# 地图API配置
MAP_API_PROVIDER=amap
MAP_API_KEY=your-map-api-key
MAP_API_SECRET=your-map-api-secret

# 推送API配置
PUSH_API_PROVIDER=jpush
PUSH_API_KEY=your-push-api-key
PUSH_API_SECRET=your-push-api-secret

# 内容审核API配置
CONTENT_API_PROVIDER=baidu
CONTENT_API_KEY=your-content-api-key
CONTENT_API_SECRET=your-content-api-secret